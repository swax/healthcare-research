{
  "name": "healthcare-flow-graph",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Single source of truth (data/graph.json, observations-first flow model) -> Excel workbook, built with native TypeScript on Node 24.",
  "scripts": {
    "build": "node src/build.ts",
    "check": "node src/check.ts",
    "test": "node --test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "derive:claims": "node scripts/derive_hi_claims.mjs",
    "reconcile:labor": "node scripts/reconcile_labor.mjs",
    "derive:finkelstein": "node scripts/extend_finkelstein_s5.mjs"
  },
  "engines": {
    "node": ">=22.6"
  },
  "dependencies": {
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.5.0",
    "globals": "^17.6.0",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0"
  }
}
